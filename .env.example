# Copy to `.env` for local development: `cp .env.example .env`.
# On EAS, set these per environment (development, preview, production)
# with `eas env:create` instead. `.env` is not uploaded to EAS builds.

# Public: inlined into the app bundle. Only `EXPO_PUBLIC_*` variables reach the
# client, so never give a secret this prefix.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret: server-side only (API routes). Never prefix with `EXPO_PUBLIC_`.
CLERK_SECRET_KEY=

# Secret: Postgres connection string for the Neon branch of this environment
# (dev locally). Server-side only. Used by API routes, drizzle-kit, and
# `npm run test:integration`.
DATABASE_URL=

# Which content versions the API serves: "approved" (default; required in
# production) or "draft", which also serves the newest unapproved draft so the
# app can run on placeholder content during development.
CONTENT_CHANNEL=draft

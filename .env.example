# Copy to `.env` for local development: `cp .env.example .env`.
# On EAS, set these per environment (development, preview, production)
# with `eas env:create` instead. `.env` is not uploaded to EAS builds.

# Public: inlined into the app bundle. Only `EXPO_PUBLIC_*` variables reach the
# client, so never give a secret this prefix.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secret: server-side only (API routes). Never prefix with `EXPO_PUBLIC_`.
CLERK_SECRET_KEY=
